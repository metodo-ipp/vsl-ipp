{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/api-server run build:handler && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/escola-de-governo run build",
  "outputDirectory": "artifacts/escola-de-governo/dist/public",
  "redirects": [
    {
      "source": "/entrar-wpp-cid",
      "destination": "https://chat.whatsapp.com/CMw3OqxTM5b8hWy4UAhxGb",
      "permanent": false
    },
    {
      "source": "/entrar-wpp-edg",
      "destination": "https://chat.whatsapp.com/GbHkxkAXYtB4oPDtXNlVXu",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
